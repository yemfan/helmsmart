{
  "name": "@leadsmart/i18n",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./locales": "./src/locales.ts",
    "./next/server": "./src/next/server.ts",
    "./next/client": "./src/next/client.tsx",
    "./locales/*.json": "./locales/*.json",
    "./locale/en/*": "./locales/en/*.json",
    "./locale/zh-Hans/*": "./locales/zh-Hans/*.json",
    "./locale/es/*": "./locales/es/*.json"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json --noEmit",
    "lint": "echo skip"
  },
  "peerDependencies": {
    "i18next": ">=23",
    "next": ">=15",
    "react": ">=18",
    "react-i18next": ">=15",
    "server-only": "*"
  },
  "peerDependenciesMeta": {
    "i18next": { "optional": true },
    "next": { "optional": true },
    "react": { "optional": true },
    "react-i18next": { "optional": true },
    "server-only": { "optional": true }
  },
  "devDependencies": {
    "typescript": "^5.1.6"
  }
}
