{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "dev": {
      "cache": false,
      "persistent": true
    },
    "build": {
      "dependsOn": ["^build"],
      "outputs": [
        ".next/**",
        "!.next/cache/**",
        "../../.next/**",
        "!../../.next/cache/**",
        "dist/**"
      ],
      "env": [
        "NEXT_PUBLIC_*",
        "EXPO_PUBLIC_*",
        "SUPABASE_*",
        "SMBAI_SUPABASE_*",
        "HELM_SUPABASE_*",
        "MEDICAL_SUPABASE_*",
        "DATABASE_URL",
        "ANTHROPIC_*",
        "OPENAI_*",
        "FAL_*",
        "SCRAPINGBEE_API_KEY",
        "SCRAPER_API_KEY",
        "WAREHOUSE_READ_TIMEOUT_MS",
        "YOUTUBE_*",
        "ELEVENLABS_*",
        "META_*",
        "LINKEDIN_*",
        "THREADS_*",
        "PINTEREST_*",
        "TIKTOK_*",
        "WECHAT_*",
        "SOCIAL_*",
        "REMOTION_*",
        "AWS_*",
        "BRAND_*",
        "TWILIO_*",
        "RETELL_*",
        "VOICE_*",
        "SMS_*",
        "SMTP_*",
        "EMAIL_*",
        "RESEND_*",
        "INBOUND_*",
        "NEWSLETTER_*",
        "MOBILE_*",
        "EXPO_ACCESS_TOKEN",
        "STRIPE_*",
        "CREDIT_*",
        "PLAID_*",
        "ALLOW_*",
        "GOOGLE_*",
        "GSC_*",
        "STEDI_*",
        "DOCUSIGN_*",
        "DOTLOOP_*",
        "FRED_*",
        "WALKSCORE_*",
        "GREATSCHOOLS_*",
        "NOMINATIM_*",
        "MAPBOX_*",
        "INDEXNOW_*",
        "KEYWORD_DISCOVERY_*",
        "LISTING_FETCH_ENABLED",
        "LEAD_ID",
        "ADMIN_*",
        "AGENT_*",
        "AI_*",
        "BOSS_*",
        "SPHERE_*",
        "OUTREACH_*",
        "OPEN_HOUSE_*",
        "OFFER_*",
        "SUPPORT_*",
        "CONTACT_FORM_TO",
        "CONSUMER_*",
        "IDX_*",
        "LEADSMART_*",
        "CLOSEBOSS_*",
        "REALTYBOSS_*",
        "PROPERTYTOOLS_*",
        "DOCTORSMART_*",
        "SEO_*",
        "PROGRAMMATIC_*",
        "CLUSTER_*",
        "COMPETITOR_*",
        "APP_BASE_URL",
        "PUBLIC_BASE_URL",
        "CRON_SECRET",
        "ENCRYPTION_KEY",
        "REVALIDATE_SECRET",
        "USE_API",
        "INTEGRATION_TEST_*",
        "SMOKE_*",
        "TEMPLATES_JSON"
      ]
    },
    "lint": {
      "dependsOn": ["^lint"]
    }
  }
}
