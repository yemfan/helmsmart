{
  "cli": {
    "version": ">= 13.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "base": {
      "corepack": false,
      "node": "20.19.4",
      "ios": {
        "image": "sdk-55"
      },
      "env": {
        "EAS_VERBOSE": "1",
        "EAS_NO_FROZEN_LOCKFILE": "1",
        "NPM_CONFIG_REGISTRY": "https://registry.npmjs.org/",
        "PNPM_CONFIG_CHILD_CONCURRENCY": "1",
        "PNPM_CONFIG_NETWORK_CONCURRENCY": "4",
        "EXPO_PUBLIC_LEADSMART_API_URL": "https://www.closebossai.com"
      }
    },
    "development": {
      "extends": "base",
      "developmentClient": true,
      "distribution": "internal"
    },
    "preview": {
      "extends": "base",
      "distribution": "internal"
    },
    "production": {
      "extends": "base",
      "distribution": "store",
      "developmentClient": false,
      "android": {
        "autoIncrement": true
      },
      "ios": {
        "image": "sdk-55",
        "autoIncrement": true
      }
    }
  },
  "submit": {
    "production": {
      "ios": {
        "appleTeamId": "5XHABQPKC2",
        "ascAppId": "6761416548"
      },
      "android": {
        "serviceAccountKeyPath": "./google-service-account.json",
        "track": "internal",
        "releaseStatus": "draft"
      }
    }
  }
}
