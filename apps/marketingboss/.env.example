# MarketingBoss AI — environment

# fal.ai API key (platform key — the app pays fal.ai; usage is metered per user
# via credits). Get one at https://fal.ai/dashboard/keys. Server-only —
# never exposed to the browser.
FAL_KEY=

# Public app URL (used for absolute links / OG). Optional in dev.
NEXT_PUBLIC_APP_URL=http://localhost:3007

# --- Billing (Slice 4: Stripe credit packs) -------------------------------
# All server-only secrets. Card payments stay off until STRIPE_SECRET_KEY is set.

# Stripe secret key (sk_live_… or sk_test_…). Creates Checkout Sessions.
STRIPE_SECRET_KEY=

# Stripe webhook signing secret (whsec_…) from the webhook endpoint you add for
# checkout.session.completed → https://<your-domain>/api/stripe/webhook
STRIPE_WEBHOOK_SECRET=

# Supabase service-role key — used ONLY server-side to credit a paid purchase
# (the webhook / checkout-success page have no user session). Never public.
SUPABASE_SERVICE_ROLE_KEY=
