# MarketingBoss AI — environment

# fal.ai API key (platform key — the app pays fal.ai; usage is metered per user
# via credits). Server-only.
FAL_KEY=

# Public app URL (used for absolute links / OG). Optional in dev.
NEXT_PUBLIC_APP_URL=http://localhost:3007

# --- Billing (Slice 4: Stripe credit packs) -------------------------------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Supabase service-role key — server-only; credits purchases + stores OAuth tokens.
SUPABASE_SERVICE_ROLE_KEY=

# --- YouTube publishing (Slice 6) -----------------------------------------
# Google OAuth (Web) app with YouTube Data API v3 + youtube.upload scope;
# redirect https://<domain>/api/youtube/callback
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=

# --- Social publishing (Phase 1) ------------------------------------------
# One MarketingBoss-branded OAuth app per provider. Each stays OFF until set.
# All redirect URIs are https://<domain>/api/social/callback/<provider>.

# Meta (Facebook + Instagram) — /api/social/callback/meta
# Scopes: pages_show_list, pages_manage_posts, pages_read_engagement,
#         business_management, instagram_basic, instagram_content_publish
META_APP_ID=
META_APP_SECRET=

# Threads — dedicated Meta Threads app — /api/social/callback/threads
THREADS_APP_ID=
THREADS_APP_SECRET=

# LinkedIn — /api/social/callback/linkedin  (scopes: openid, profile, w_member_social)
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

# Pinterest — /api/social/callback/pinterest  (scopes: boards:read, pins:read, pins:write)
PINTEREST_APP_ID=
PINTEREST_APP_SECRET=
